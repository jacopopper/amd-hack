FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12.3-slim-bookworm@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY pyproject.toml ./
COPY backend/ backend/
COPY guidance/ guidance/
RUN pip install --no-deps -e .
COPY --from=web /web/dist web/dist/
ENV PYTHONUNBUFFERED=1 SAFE_HOME_DATA=/data
EXPOSE 8000
CMD ["uvicorn", "safe_home.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
