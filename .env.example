# Staged / fictional data only. Copy locally; never commit credentials.
STEP_WISE_DATA=data
# Keep this shared when running a case worker against an isolated database.
# STEP_WISE_WORKER_LOCK=/absolute/path/to/data/worker.lock
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=replace-with-a-long-random-password
REVIEWER_IDENTITY=Team member — simulated reviewer
RECON_BACKEND=vggt
GEMMA_BACKEND=http
JEV_ENABLED=false
# Live only; never sent to the browser.
JEV_API_KEY=
GEMMA_BASE_URL=https://router.huggingface.co/v1
GEMMA_MODEL=google/gemma-4-31B-it
GEMMA_PROVIDER=deepinfra
GEMMA_MODEL_REVISION=
GEMMA_TIMEOUT_SECONDS=120
AVATAR_BACKEND=fixture
BLENDER_BIN=
# Optional isolated Blender profile paths; set them when installing MPFB2 in a project-local profile.
BLENDER_HOME=
BLENDER_USER_CONFIG=
XDG_CONFIG_HOME=
XDG_DATA_HOME=
MPFB_ASSET_PACK_SHA256=
AVATAR_TIMEOUT_SECONDS=300
VGGT_PYTHON=model-cache/vggt-env/bin/python3
VGGT_TIMEOUT_SECONDS=900
# Measured resource cap at 518 pixels, not a reconstruction-quality guarantee.
VGGT_FRAME_CAP=20
STEP_WISE_MAX_PHOTOS=40
STEP_WISE_MAX_FILE_BYTES=20971520
STEP_WISE_MAX_ASSESSMENT_BYTES=209715200
STEP_WISE_MAX_PIXELS=40000000
VGGT_CHECKPOINT=model-cache/VGGT-1B/model.pt
VGGT_COMMIT=a288dd0f14786c93483e45524328726ab7b1b4ce
VGGT_CHECKPOINT_SHA256=d15bf50a8615c8225ed48b51ea5cac673d82442ec0309036df555a053253afe0
# GPU containers: no default runtime images are claimed validated.
ROCM_WORKER_BASE=
VLLM_ROCM_IMAGE=
VIDEO_GID=
RENDER_GID=
HF_TOKEN=
# Optional loopback host port for Compose.
STEP_WISE_PORT=8000
